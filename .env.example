# Seguridad local. Cambiar en producción.
JWT_SECRET=cambia-esta-clave
TOKEN_ENCRYPTION_KEY=cambia-esta-clave-larga-para-tokens
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001

# Verificación real por email (opcional en desarrollo).
# Si RESEND_API_KEY queda vacío, Adara muestra un enlace local de verificación para QA.
RESEND_API_KEY=
EMAIL_FROM=Adara Web <no-reply@tu-dominio.com>

# OAuth de Mercado Pago de la plataforma.
# Cada profesional conectará SU propia cuenta con este OAuth.
MP_PLATFORM_CLIENT_ID=
MP_PLATFORM_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/mercadopago/callback

# En desarrollo permite simular un pago aprobado sin credenciales reales.
DEMO_PAYMENTS=true

# Google Calendar OAuth. Activar Calendar API y registrar esta URI en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# WhatsApp Business Cloud API de la plataforma (no WhatsApp personal).
# Elegir la versión vigente de Graph API en Meta y usar plantillas aprobadas.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_WAITLIST_TEMPLATE=

# Suscripciones pagadas a Adara (cuenta de la dueña de la plataforma).
# Nunca usar el token OAuth de una profesional para estos cobros.
MP_BILLING_ACCESS_TOKEN=
MP_BILLING_WEBHOOK_SECRET=
# Simulación sólo local: se deshabilita siempre con NODE_ENV=production.
DEMO_SUBSCRIPTIONS=true

# Producción en Render: render.yaml configura NODE_ENV, disco y claves aleatorias.
# Se crea el Super Admin sólo en el primer inicio, si no existe ninguno.
# SUPERADMIN_EMAIL=tu-email
# SUPERADMIN_PASSWORD=contraseña de al menos 12 caracteres
# DATA_DIR=/var/data
# UPLOADS_DIR=/var/data/uploads
# FRONTEND_URL y PUBLIC_API_URL toman RENDER_EXTERNAL_URL automáticamente si no se definen.
# Para un dominio propio, definir ambos con la URL HTTPS nueva.
